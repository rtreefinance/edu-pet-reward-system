# ============================================================
# Environment Variables for Pet Reward System
# Copy this file to .env and fill in your values
# ============================================================

# ---- Server ----
NODE_ENV=production
PORT=3001

# ---- MongoDB ----
# Local development: mongodb://localhost:27017/pet-reward
# Docker compose:    mongodb://mongodb:27017/pet-reward
# Cloud (Atlas):     mongodb+srv://<user>:<pass>@cluster.mongodb.net/pet-reward
MONGO_URI=mongodb://localhost:27017/pet-reward

# ---- JWT Auth ----
# Generate a strong random secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_IN=7d

# ---- Client (optional) ----
VITE_API_URL=http://localhost:3001/api
